{
	"name": "site-word-counter",
	"version": "1.0.1",
	"description": "A block that shows the total number of words published across your site.",
	"author": "Derek Hanson",
	"license": "GPL-2.0-or-later",
	"private": true,
	"main": "compiled/index.js",
	"scripts": {
		"build": "wp-scripts build --webpack-copy-php --experimental-modules --output-path=compiled",
		"start": "wp-scripts start --webpack-copy-php --experimental-modules --output-path=compiled",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style \"src/**/*.scss\"",
		"lint:js": "wp-scripts lint-js src",
		"lint:php": "composer run phpcs",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "npx pressship pack ."
	},
	"devDependencies": {
		"@wordpress/scripts": "36.0.0"
	},
	"dependencies": {
		"@wordpress/admin-ui": "2.11.0",
		"@wordpress/theme": "2.2.0",
		"@wordpress/ui": "0.23.0"
	}
}
